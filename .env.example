APP_NAME="Reminder Absen MagangHub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE="C:\Users\HP\OneDrive\Documents\CODINGAN\BOT\bot_reminder_absen_maganghub\database\database.sqlite"
# Untuk cPanel production:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=reminder_absen
# DB_USERNAME=YOUR_CPANEL_DB_USER
# DB_PASSWORD=YOUR_CPANEL_DB_PASS

# Web Push VAPID — generate via: php artisan web-push:vapid
VAPID_SUBJECT="mailto:admin@yourdomain.com"

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Email (channel kedua selain push). Isi kredensial mailbox cPanel.
# Kalau MAIL_MAILER=log, email tidak dikirim — hanya ditulis ke log.
# Catatan Laravel 12: pakai MAIL_SCHEME (bukan MAIL_ENCRYPTION).
#   smtps = TLS langsung (port 465)  |  smtp = STARTTLS (port 587)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=absenhub@pinnhost.my.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="absenhub@pinnhost.my.id"
MAIL_FROM_NAME="Reminder Absen MagangHub"
# EHLO pakai hostname server supaya tidak ditolak Exim.
MAIL_EHLO_DOMAIN=mten.kencang.id

# Opsional — link dashboard absen eksternal
MAGANGHUB_DASHBOARD_URL=https://monev.maganghub.kemnaker.go.id/dashboard/riwayat
MAGANGHUB_LOGIN_URL=https://account.kemnaker.go.id/auth/login

# Jam reminder (WITA / Asia/Makassar). Cron trigger di jam ini.
# Sore -> malam -> peringatan terakhir sebelum batas absen 00:00.
REMINDER_SLOT_1=16:30
REMINDER_SLOT_2=20:30
REMINDER_SLOT_3=23:00